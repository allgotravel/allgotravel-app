/* Landing homepage styles — scoped under .lp */
.lp{--navy:#0E2236; --teal:#0C8F83; --tealb:#16C7B6; --blue:#4EA8E0; --orange:#F5A628;
 --ink:#0E2236; --muted:#5B7185; --line:#E6EDF1; --bg:#FFFFFF; --soft:#F4F9FA; --card:#FFFFFF;
 --radius:20px; --shadow:0 18px 48px rgba(14,34,54,.10); --shadow-sm:0 8px 24px rgba(14,34,54,.08);}
.lp *{box-sizing:border-box}
.lp{scroll-behavior:smooth}
.lp{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Inter,Roboto,Helvetica,Arial,sans-serif;color:var(--ink);background:var(--bg);line-height:1.55;-webkit-font-smoothing:antialiased}
.lp img{max-width:100%;display:block}
.lp a{color:inherit;text-decoration:none}
.lp .wrap{max-width:1140px;margin:0 auto;padding:0 22px}
.lp h1, .lp h2, .lp h3{line-height:1.12;letter-spacing:-.02em;margin:0}
.lp h1{font-size:clamp(34px,6vw,64px);font-weight:800}
.lp h2{font-size:clamp(26px,3.6vw,42px);font-weight:800}
.lp h3{font-size:clamp(19px,2vw,23px);font-weight:800}
.lp p{margin:.6em 0}
.lp .kicker{display:inline-block;font-size:12.5px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--teal);background:#E8F7F4;padding:7px 13px;border-radius:999px}
.lp .btn{display:inline-flex;align-items:center;gap:9px;font-weight:800;font-size:16px;padding:15px 26px;border-radius:999px;border:0;cursor:pointer;transition:transform .15s ease,box-shadow .15s ease}
.lp .btn:focus-visible{outline:3px solid var(--blue);outline-offset:3px}
.lp .btn-primary{background:var(--orange);color:#3a2400;box-shadow:0 10px 26px rgba(245,166,40,.42)}
.lp .btn-primary:hover{transform:translateY(-2px);box-shadow:0 16px 34px rgba(245,166,40,.5)}
.lp .btn-ghost{background:#fff;color:var(--navy);border:1.5px solid var(--line)}
.lp .btn-ghost:hover{border-color:var(--tealb);transform:translateY(-2px)}
.lp .btn-white{background:#fff;color:var(--navy)}
.lp .muted{color:var(--muted)}
.lp .section{padding:88px 0}
.lp .center{text-align:center}
.lp .lead{font-size:clamp(16px,1.5vw,19px);color:var(--muted);max-width:640px}
.lp /* NAV */
header.nav{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.86);backdrop-filter:saturate(160%) blur(12px);border-bottom:1px solid var(--line)}
.lp .nav .row{display:flex;align-items:center;justify-content:space-between;height:68px}
.lp .brand{display:flex;align-items:center;gap:10px;font-weight:800;font-size:18px;color:var(--navy)}
.lp .brandlogo{width:38px;height:38px;object-fit:contain;flex:none}
.lp .brand .dot{width:30px;height:30px;border-radius:9px;background:linear-gradient(135deg,var(--tealb),var(--blue));display:grid;place-items:center;color:#fff;font-size:15px}
.lp .navlinks{display:flex;gap:26px;align-items:center}
.lp .navlinks a{font-size:14.5px;font-weight:600;color:#33475b}
.lp .navlinks a:hover{color:var(--teal)}
.lp .pill{border:1px solid var(--line);border-radius:999px;padding:5px 10px;font-size:12px;font-weight:700;color:var(--muted)}
.lp .nav .cta{background:var(--navy);color:#fff;padding:11px 20px;border-radius:999px;font-weight:800;font-size:14.5px}
.lp .nav .cta:hover{background:#0a1a2a}
.lp .menuwrap{display:flex;align-items:center;gap:16px}
@media(max-width:860px){
.lp .navlinks{display:none}
}
.lp /* HERO */
.hero{background:radial-gradient(1200px 500px at 80% -10%,#EAF7F4 0,transparent 60%),linear-gradient(180deg,#F7FBFC, #fff)}
.lp .hero .grid{display:grid;grid-template-columns:1.05fr .95fr;gap:50px;align-items:center;padding:70px 0 84px}
.lp .hero h1{margin:16px 0 6px}
.lp .hero h1 .hl{color:var(--teal)}
.lp .hero .sub{font-size:clamp(16px,1.7vw,20px);color:#33475b;max-width:540px;margin:14px 0 26px}
.lp .hero .actions{display:flex;gap:14px;flex-wrap:wrap}
.lp .rating{display:flex;align-items:center;gap:12px;margin-top:24px;color:var(--muted);font-size:14px;font-weight:600}
.lp .stars{color:#F5A628;letter-spacing:2px;font-size:16px}
.lp .heroimg{position:relative}
.lp .heroimg img{width:100%;border-radius:26px;box-shadow:var(--shadow);object-fit:cover;aspect-ratio:5/6}
.lp .badge-float{position:absolute;left:-14px;bottom:22px;background:#fff;border-radius:16px;box-shadow:var(--shadow-sm);padding:12px 16px;display:flex;align-items:center;gap:11px;font-weight:700;font-size:14px}
.lp .badge-float .ic{width:34px;height:34px;border-radius:10px;background:#E8F7F4;color:var(--teal);display:grid;place-items:center;font-size:17px}
@media(max-width:860px){
.lp .hero .grid{grid-template-columns:1fr;padding:44px 0 56px}
.lp .heroimg{order:-1}
}
.lp /* TRUST BAR */
.trust{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--soft)}
.lp .trust .row{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;padding:30px 0;text-align:center}
.lp .trust .n{font-size:clamp(24px,3vw,34px);font-weight:800;color:var(--navy)}
.lp .trust .l{font-size:13px;color:var(--muted);font-weight:600}
@media(max-width:700px){
.lp .trust .row{grid-template-columns:repeat(2,1fr);gap:24px}
}
.lp /* GENERIC CARDS */
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.lp .grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.lp .grid2{display:grid;grid-template-columns:repeat(2,1fr);gap:26px}
@media(max-width:900px){
.lp .grid3, .lp .grid4{grid-template-columns:repeat(2,1fr)}
.lp .grid2{grid-template-columns:1fr}
}
@media(max-width:560px){
.lp .grid3, .lp .grid4{grid-template-columns:1fr}
}
.lp .card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:26px;box-shadow:var(--shadow-sm)}
.lp .card .ic{width:48px;height:48px;border-radius:14px;display:grid;place-items:center;font-size:24px;background:#E8F7F4;color:var(--teal);margin-bottom:14px}
.lp .card h3{margin-bottom:6px}
.lp .card p{color:var(--muted);font-size:15px;margin:0}
.lp /* PROBLEM/SOLUTION */
.split{display:grid;grid-template-columns:1fr 1fr;gap:46px;align-items:center}
@media(max-width:860px){
.lp .split{grid-template-columns:1fr;gap:30px}
}
.lp .checklist{list-style:none;padding:0;margin:18px 0 0}
.lp .checklist li{display:flex;gap:12px;align-items:flex-start;margin:12px 0;font-size:16px}
.lp .checklist .tk{flex:none;width:26px;height:26px;border-radius:50%;background:#E8F7F4;color:var(--teal);display:grid;place-items:center;font-weight:800;font-size:14px}
.lp /* APP SECTION */
.app{background:linear-gradient(180deg,#0E2236,#12324a);color:#fff}
.lp .app .split{align-items:center}
.lp .app h2{color:#fff}
.lp .app .lead{color:#c7d6e2}
.lp .app .phone{max-width:320px;margin:0 auto;border-radius:30px;box-shadow:0 30px 70px rgba(0,0,0,.4);border:6px solid #0a1a2a}
.lp .app .feat{list-style:none;padding:0;margin:18px 0 0}
.lp .app .feat li{display:flex;gap:12px;margin:12px 0;color:#dfeaf2;font-size:16px}
.lp .app .feat .tk{flex:none;width:26px;height:26px;border-radius:50%;background:rgba(22,199,182,.18);color:var(--tealb);display:grid;place-items:center;font-weight:800}
.lp .pillrow{display:flex;gap:10px;flex-wrap:wrap;margin-top:8px}
.lp .chip{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.16);color:#dfeaf2;font-size:13px;font-weight:600;padding:7px 13px;border-radius:999px}
.lp /* PRODUCTS */
.prod{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:22px}
@media(max-width:900px){
.lp .prod{grid-template-columns:1fr}
}
.lp .prodcard{background:#fff;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow-sm);display:flex;flex-direction:column}
.lp .prodcard .ph{background:var(--soft);padding:22px;display:grid;place-items:center}
.lp .prodcard .ph img{border-radius:12px;box-shadow:var(--shadow-sm);max-height:230px;width:auto}
.lp .prodcard .bd{padding:22px;display:flex;flex-direction:column;flex:1}
.lp .prodcard .price{font-size:26px;font-weight:800;color:var(--navy)}
.lp .prodcard .old{color:#9fb2c0;text-decoration:line-through;font-size:16px;margin-left:6px;font-weight:600}
.lp .prodcard p{color:var(--muted);font-size:14.5px;flex:1}
.lp .tag{display:inline-block;font-size:11.5px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--orange);background:#FFF3E0;padding:5px 10px;border-radius:999px;margin-bottom:10px;align-self:flex-start}
.lp /* NEEDS */
.needs{background:var(--soft)}
.lp .need{background:#fff;border:1px solid var(--line);border-radius:16px;padding:20px}
.lp .need .e{font-size:26px}
.lp .need h3{font-size:17px;margin:8px 0 4px}
.lp .need p{color:var(--muted);font-size:14px;margin:0}
.lp /* PRICING */
.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;align-items:stretch}
@media(max-width:900px){
.lp .plans{grid-template-columns:1fr}
}
.lp .plan{background:#fff;border:1.5px solid var(--line);border-radius:var(--radius);padding:28px;display:flex;flex-direction:column;box-shadow:var(--shadow-sm)}
.lp .plan.featured{border-color:var(--orange);box-shadow:0 20px 44px rgba(245,166,40,.22);position:relative}
.lp .plan .ptag{position:absolute;top:-13px;left:24px;background:var(--orange);color:#3a2400;font-weight:800;font-size:12px;padding:5px 12px;border-radius:999px}
.lp .plan h3{color:var(--blue)}
.lp .plan .pr{font-size:38px;font-weight:800;margin:8px 0 2px}
.lp .plan .pr small{font-size:15px;color:var(--muted);font-weight:600}
.lp .plan .was{font-size:17px;color:#9fb2c0;text-decoration:line-through;font-weight:700;margin-right:6px}
.lp .plan ul{list-style:none;padding:0;margin:14px 0 18px;flex:1}
.lp .plan ul li{display:flex;gap:9px;margin:9px 0;font-size:14.5px;color:#33475b}
.lp .plan ul .tk{color:var(--teal);font-weight:800}
.lp /* STORY */
.story{background:linear-gradient(180deg,#fff,#F7FBFC)}
.lp .storycard{background:#fff;border:1px solid var(--line);border-radius:26px;box-shadow:var(--shadow);overflow:hidden}
.lp .storycard .split{gap:0}
.lp .storycard .txt{padding:44px}
.lp .storycard img{height:100%;width:100%;object-fit:cover;min-height:340px}
.lp .sig{font-weight:800;color:var(--navy);margin-top:14px}
.lp /* TESTIMONIALS */
.tcard{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:26px;box-shadow:var(--shadow-sm)}
.lp .tcard .st{color:var(--orange);letter-spacing:2px}
.lp .tcard p{font-size:16px}
.lp .tcard .who{font-weight:800;color:var(--navy);margin-top:8px}
.lp .tcard .who small{display:block;color:var(--muted);font-weight:600}
.lp /* DIFF */
.diff{background:var(--navy);color:#fff}
.lp .diff h2{color:#fff}
.lp .diff .lead{color:#c7d6e2}
.lp .diff .grid4 .card{background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.12);color:#fff}
.lp .diff .card p{color:#c7d6e2}
.lp .diff .card .ic{background:rgba(22,199,182,.16);color:var(--tealb)}
.lp .note{margin-top:26px;background:rgba(22,199,182,.12);border:1px solid rgba(22,199,182,.35);border-radius:16px;padding:18px 22px;font-weight:600}
.lp /* FAQ */
.faq details{border:1px solid var(--line);border-radius:14px;padding:4px 20px;margin:12px 0;background:#fff}
.lp .faq summary{cursor:pointer;font-weight:700;padding:16px 0;list-style:none;display:flex;justify-content:space-between;align-items:center;font-size:16.5px}
.lp .faq summary::-webkit-details-marker{display:none}
.lp .faq summary::after{content:"+";color:var(--teal);font-size:24px;font-weight:700}
.lp .faq details[open] summary::after{content:"–"}
.lp .faq p{color:var(--muted);padding-bottom:16px;margin:0}
.lp /* CTA */
.finalcta{background:linear-gradient(135deg,var(--teal),var(--blue));color:#fff;text-align:center}
.lp .finalcta h2{color:#fff;font-size:clamp(28px,4vw,46px)}
.lp .finalcta p{color:#eaffff;max-width:560px;margin:12px auto 26px}
.lp /* FOOTER */
footer{background:#0a1a2a;color:#aebfce;padding:56px 0 30px;font-size:14px}
.lp footer .cols{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:24px}
@media(max-width:800px){
.lp footer .cols{grid-template-columns:1fr 1fr}
}
.lp footer h4{color:#fff;font-size:14px;margin:0 0 12px;letter-spacing:.04em}
.lp footer a{display:block;color:#aebfce;margin:8px 0}
.lp footer a:hover{color:#fff}
.lp footer .brand{color:#fff}
.lp footer .legal{border-top:1px solid rgba(255,255,255,.1);margin-top:34px;padding-top:20px;color:#7c92a6;font-size:12.5px}
.lp .reveal{opacity:0;transform:translateY(18px);transition:opacity .6s ease,transform .6s ease}
.lp .reveal.in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){
.lp .reveal{opacity:1;transform:none;transition:none}
}
